---
/**
 * DocsLayout - Full-width content with floating navigation overlay
 *
 * Navigation is always an overlay (never takes layout space).
 * A floating toggle button sits at the top-left corner of the content area.
 * Content is always full width.
 *
 * Requirements: 3.1, 3.2, 3.3, 10.2
 */
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Sidebar from "@/components/Sidebar.astro";
import type { NavigationTree } from "@/types/navigation";
import { SITE } from "@/config";
import "@/styles/global.css";
import "@/styles/docs.css";

interface Props {
  title: string;
  description?: string;
  navigationTree: NavigationTree;
  currentPath: string;
}

const { title, description, navigationTree, currentPath } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.url);
const ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png";
const socialImageURL = new URL(ogImage, Astro.url);
---

<!doctype html>
<html dir={SITE.dir} lang={SITE.lang ?? "en"} class="docs-layout">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-space-grotesk" preload={[{ subset: "vietnamese", weight: 400, style: "normal" }]} />
    <title>{title} | {SITE.title}</title>
    <meta name="title" content={`${title} | ${SITE.title}`} />
    <meta name="description" content={description ?? SITE.desc} />
    <meta name="author" content={SITE.author} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? SITE.desc} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description ?? SITE.desc} />
    <meta property="twitter:image" content={socialImageURL} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL("rss.xml", Astro.site)} />
    <meta name="theme-color" content="" />
    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    <ClientRouter />
    <script is:inline>
      (function () {
        const t = localStorage.getItem("theme");
        const v = t || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", v);
        window.theme = { themeValue: v, getTheme: () => window.theme.themeValue, setTheme: val => { window.theme.themeValue = val; } };
      })();
    </script>
  </head>

  <body class="h-screen overflow-hidden flex flex-col bg-background text-foreground font-app">

    <!-- Header: sticky, never scrolls -->
    <div class="shrink-0">
      <Header />
    </div>

    <!-- Main layout: centered container with 3 columns -->
    <div class="flex-1 overflow-hidden">
      <div class="h-full mx-auto max-w-[1600px] flex">
        
        <!-- Left sidebar: Navigation (hidden on mobile, fixed on desktop) -->
        <aside class="hidden lg:block w-56 xl:w-64 shrink-0 overflow-y-auto border-r border-border bg-background">
          <div class="py-4 px-3">
            <Sidebar navigationTree={navigationTree} currentPath={currentPath} />
          </div>
        </aside>

        <!-- Center: Main content -->
        <main id="main-content" class="flex-1 min-w-0 overflow-y-auto">
          <div class="mx-auto px-6 pb-10 pt-8 lg:px-8" style="max-width: 768px;">
            <article class="app-prose w-full prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)" style="max-width: 768px;">
              <slot />
            </article>
          </div>
          <Footer />
        </main>

        <!-- Right sidebar: Table of Contents (hidden on mobile/tablet) -->
        <aside class="hidden xl:block w-56 shrink-0 overflow-y-auto border-l border-border bg-background">
          <div class="sticky top-0 py-4 px-3">
            <h3 class="text-sm font-semibold text-foreground/80 mb-3">On this page</h3>
            <nav id="toc-nav" class="text-sm space-y-2">
              <!-- TOC will be generated by JS -->
            </nav>
          </div>
        </aside>

      </div>
    </div>

    <!-- Mobile: Floating toggle button (only visible on mobile) -->
    <button
      id="nav-toggle-btn"
      class="lg:hidden fixed bottom-6 right-6 z-30
             flex items-center gap-2 px-4 py-3 rounded-full
             bg-accent text-accent-foreground shadow-lg
             hover:shadow-xl transition-shadow duration-150"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="nav-overlay-panel"
    >
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        class="hidden" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <!-- Mobile: Navigation overlay panel -->
    <div
      id="nav-overlay-panel"
      class="lg:hidden fixed top-0 left-0 z-50 h-full w-72 max-w-[85vw]
             bg-background border-r border-border shadow-xl
             -translate-x-full transition-transform duration-300 ease-in-out
             overflow-y-auto"
      aria-label="Documentation navigation"
    >
      <!-- Panel header with close button -->
      <div class="flex items-center justify-between px-4 py-3 border-b border-border sticky top-0 bg-background z-10">
        <span class="text-sm font-semibold text-foreground/80">Navigation</span>
        <button
          id="nav-close-btn"
          class="flex items-center justify-center size-8 rounded-md text-foreground/60 hover:bg-accent/10 hover:text-accent transition-colors"
          aria-label="Close navigation"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Nav items -->
      <Sidebar navigationTree={navigationTree} currentPath={currentPath} />
    </div>

    <script>
      function initDocsNav() {
        const toggleBtn = document.getElementById("nav-toggle-btn");
        const closeBtn = document.getElementById("nav-close-btn");
        const panel = document.getElementById("nav-overlay-panel");
        const iconOpen = document.getElementById("nav-icon-open");
        const iconClose = document.getElementById("nav-icon-close");

        if (!toggleBtn || !panel) return;

        function openNav() {
          panel!.classList.remove("-translate-x-full");
          toggleBtn!.setAttribute("aria-expanded", "true");
          iconOpen?.classList.add("hidden");
          iconClose?.classList.remove("hidden");
        }

        function closeNav() {
          panel!.classList.add("-translate-x-full");
          toggleBtn!.setAttribute("aria-expanded", "false");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        }

        toggleBtn.addEventListener("click", () => {
          toggleBtn.getAttribute("aria-expanded") === "true" ? closeNav() : openNav();
        });

        closeBtn?.addEventListener("click", closeNav);

        document.addEventListener("keydown", e => {
          if (e.key === "Escape" && toggleBtn.getAttribute("aria-expanded") === "true") {
            closeNav();
          }
        });
      }

      initDocsNav();
      document.addEventListener("astro:after-swap", initDocsNav);
    </script>

    <script>
      // Generate Table of Contents from headings
      function generateTOC() {
        const article = document.querySelector('article');
        const tocNav = document.getElementById('toc-nav');
        const mainContent = document.getElementById('main-content');
        
        if (!article || !tocNav || !mainContent) return;

        const headings = article.querySelectorAll('h2, h3');
        
        if (headings.length === 0) {
          tocNav.innerHTML = '<p class="text-foreground/40 text-xs">No headings found</p>';
          return;
        }

        const tocHTML = Array.from(headings).map(heading => {
          const level = heading.tagName === 'H2' ? 0 : 1;
          const id = heading.id || heading.textContent?.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '') || '';
          
          if (!heading.id && id) {
            heading.id = id;
          }

          const indent = level === 0 ? '' : 'ml-3';
          const textSize = level === 0 ? 'font-medium' : 'text-xs';
          
          return `
            <a href="#${id}" 
               class="toc-link block py-1 ${indent} ${textSize} text-foreground/60 hover:text-accent transition-colors"
               data-heading-id="${id}">
              ${heading.textContent}
            </a>
          `;
        }).join('');

        tocNav.innerHTML = tocHTML;

        // Handle TOC link clicks to scroll within main content
        tocNav.querySelectorAll('.toc-link').forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = link.getAttribute('href')?.substring(1);
            if (!targetId) return;
            
            const targetHeading = document.getElementById(targetId);
            if (!targetHeading) return;

            // Scroll the main content container to the heading
            const mainRect = mainContent.getBoundingClientRect();
            const headingRect = targetHeading.getBoundingClientRect();
            const scrollTop = mainContent.scrollTop;
            const offset = headingRect.top - mainRect.top + scrollTop - 20; // 20px padding from top

            mainContent.scrollTo({
              top: offset,
              behavior: 'smooth'
            });

            // Update URL hash without triggering default scroll
            history.pushState(null, '', `#${targetId}`);
          });
        });

        // Highlight active heading on scroll
        const observer = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              const id = entry.target.id;
              const tocLink = tocNav.querySelector(`[data-heading-id="${id}"]`);
              
              if (entry.isIntersecting) {
                // Remove active from all
                tocNav.querySelectorAll('.toc-link').forEach(link => {
                  link.classList.remove('text-accent', 'font-semibold');
                  link.classList.add('text-foreground/60');
                });
                // Add active to current
                if (tocLink) {
                  tocLink.classList.remove('text-foreground/60');
                  tocLink.classList.add('text-accent', 'font-semibold');
                }
              }
            });
          },
          { 
            root: mainContent,
            rootMargin: '-100px 0px -66%' 
          }
        );

        headings.forEach(heading => observer.observe(heading));
      }

      generateTOC();
      document.addEventListener('astro:after-swap', generateTOC);
    </script>

    <script src="../scripts/theme.ts"></script>

    <!-- Load and render Mermaid diagrams dynamically -->
    <script is:inline>
      (function() {
        function initMermaid() {
          const codeBlocks = Array.from(document.querySelectorAll('pre')).filter(pre => {
            const code = pre.querySelector('code');
            return pre.getAttribute('data-language') === 'mermaid' ||
                   pre.classList.contains('language-mermaid') || 
                   pre.classList.contains('mermaid') ||
                   (code && (code.classList.contains('language-mermaid') || code.classList.contains('mermaid')));
          });

          if (codeBlocks.length === 0) return;

          const runMermaid = () => {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            mermaid.initialize({
              startOnLoad: false,
              theme: isDark ? 'dark' : 'default',
              securityLevel: 'loose'
            });

            codeBlocks.forEach(block => {
              const codeEl = block.querySelector('code') || block;
              const rawText = codeEl.textContent.trim();
              
              const container = document.createElement('div');
              container.className = 'mermaid';
              container.setAttribute('data-mermaid-src', rawText);
              container.textContent = rawText;
              
              // Handle wrapper created by copy-code script
              const parent = block.parentNode;
              if (parent && parent.tagName === 'DIV' && parent.style.position === 'relative' && parent.querySelector('button.copy-code')) {
                parent.replaceWith(container);
              } else {
                block.replaceWith(container);
              }
            });

            mermaid.run();
          };

          if (window.mermaid) {
            runMermaid();
          } else {
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
            script.onload = runMermaid;
            document.head.appendChild(script);
          }
        }

        function handleThemeChange() {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          const diagrams = document.querySelectorAll('.mermaid');
          if (diagrams.length === 0 || !window.mermaid) return;

          mermaid.initialize({
            startOnLoad: false,
            theme: isDark ? 'dark' : 'default'
          });

          diagrams.forEach(diagram => {
            const src = diagram.getAttribute('data-mermaid-src');
            if (!src) return;

            const container = document.createElement('div');
            container.className = 'mermaid';
            container.setAttribute('data-mermaid-src', src);
            container.textContent = src;

            diagram.replaceWith(container);
          });

          mermaid.run();
        }

        const observer = new MutationObserver(mutations => {
          mutations.forEach(mutation => {
            if (mutation.attributeName === 'data-theme') {
              handleThemeChange();
            }
          });
        });
        observer.observe(document.documentElement, { attributes: true });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMermaid);
        } else {
          initMermaid();
        }
        document.addEventListener('astro:after-swap', initMermaid);
      })();
    </script>
  </body>
</html>
