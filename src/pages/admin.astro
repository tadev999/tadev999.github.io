      filesListContainer.innerHTML = `<div class="text-center py-8 text-rose-500 text-xs">
        Lỗi tải dữ liệu. Hãy đăng xuất và đăng nhập lại.
      </div>`;
    }
  }

  // Simple key-value YAML frontmatter parser
  function parseFrontmatter(fileContent: string) {
    const match = fileContent.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
    if (!match) {
      return { data: {} as any, content: fileContent };
    }
    const yamlStr = match[1];
    const content = match[2];
    const data: Record<string, any> = {};
    
    const lines = yamlStr.split('\n');
    let currentKey = null;
    let currentList: any[] | null = null;

    for (let line of lines) {
      line = line.trim();
      if (!line) continue;

      if (line.startsWith('-') && currentKey && currentList) {
        const val = line.substring(1).trim().replace(/^['"]|['"]$/g, '');
        currentList.push(val);
        continue;
      }

      currentList = null;

      const colonIndex = line.indexOf(':');
      if (colonIndex !== -1) {
        const key = line.substring(0, colonIndex).trim();
        let val = line.substring(colonIndex + 1).trim();

        if (val.startsWith('[') && val.endsWith(']')) {
          const items = val.substring(1, val.length - 1)
            .split(',')
            .map(i => i.trim().replace(/^['"]|['"]$/g, ''))
            .filter(Boolean);
          data[key] = items;
        } else if (val === '' || val === '[]') {
          currentKey = key;
          currentList = [];
          data[key] = currentList;
        } else {
          val = val.replace(/^['"]|['"]$/g, '');
          if (val === 'true') data[key] = true;
          else if (val === 'false') data[key] = false;
          else if (!isNaN(val as any) && val !== '') data[key] = Number(val);
          else data[key] = val;
        }
      }
    }
    return { data, content };
  }

  // YAML Stringifier
  function stringifyFrontmatter(data: Record<string, any>) {
    let str = '---\n';
    for (const [key, val] of Object.entries(data)) {
      if (val === undefined || val === null) continue;
      if (Array.isArray(val)) {
        str += `${key}:\n`;
        for (const item of val) {
          str += `  - ${item}\n`;
        }
      } else if (typeof val === 'string') {
        str += `${key}: "${val.replace(/"/g, '\\"')}"\n`;
      } else {
        str += `${key}: ${val}\n`;
      }
    }
    str += '---\n';
    return str;
  }

  // Scan blog files to get tags (runs only once after fetch)
  async function extractExistingTags() {
    const tagsSet = new Set<string>();

    // Limit scanning to first few files or just use predefined ones to save calls,
    // actually, we don't have frontmatter contents immediately here since it's just the tree listing.
    // Instead of calling GET for all blog posts, we can read tags from the filenames or use typical presets,
    // or we can fetch a few recent files. Let's provide some default suggestions + scan the titles/paths.
    const defaultSuggestions = ['scrum', 'agile', 'testing', 'flutter', 'node', 'productivity', 'antigravity', 'spec-driven', 'jira'];
    defaultSuggestions.forEach(t => tagsSet.add(t));
    
    existingTags = Array.from(tagsSet);
  }

  // Construct collapsible tree for Docs files
  function buildDocsTree(paths: any[]) {
    const root = { name: 'root', type: 'directory', children: {} as any, files: [] as any[] };
    
    for (const item of paths) {
      const parts = item.path.split('/');
      let current = root;
      
      // We only care about paths inside src/data/docs/
      if (parts[0] !== 'src' || parts[1] !== 'data' || parts[2] !== 'docs') continue;
      
      const relativeParts = parts.slice(3);
      if (relativeParts.length === 0) continue;
      
      for (let i = 0; i < relativeParts.length; i++) {
        const part = relativeParts[i];
        const isLast = i === relativeParts.length - 1;
        
        if (isLast) {
          if (part.endsWith('.md') || part.endsWith('.mdx')) {
            current.files.push({
              name: part,
              path: item.path,
              sha: item.sha,
              type: 'file',
              relativePath: relativeParts.join('/')
            });
          }
        } else {
          if (!current.children[part]) {
            current.children[part] = {
              name: part,
              type: 'directory',
              children: {},
              files: [],
              path: parts.slice(0, 4 + i).join('/')
            };
          }
          current = current.children[part];
        }
      }
    }
    return root;
  }

  // Get list of folders inside src/data/docs
  function getDocsFolders() {
    const folders = new Set<string>();
    
    repoFiles.forEach(item => {
      const parts = item.path.split('/');
      if (parts[0] === 'src' && parts[1] === 'data' && parts[2] === 'docs') {
        // Find directories
        if (item.type === 'tree') {
          const relPath = parts.slice(3).join('/');
          if (relPath) folders.add(relPath);
        } else if (parts.length > 4) {
          // If a file is in a subdirectory, add the subdirectory path
          const relPath = parts.slice(3, -1).join('/');
          if (relPath) folders.add(relPath);
        }
      }
    });

    return Array.from(folders).sort();
  }

  // Render sidebar items
  function renderFiles() {
    filesListContainer.innerHTML = '';
    
    if (activeTab === 'blog') {
      const blogItems = repoFiles.filter(item => 
        item.path.startsWith('src/data/blog/') && 
        item.type === 'blob' && 
        (item.path.endsWith('.md') || item.path.endsWith('.mdx'))
      );

      // Sort newest first based on filename prefix (which usually has dates) or alphabetically
      blogItems.sort((a, b) => b.path.localeCompare(a.path));

      if (blogItems.length === 0) {
        filesListContainer.innerHTML = '<div class="text-center py-8 text-foreground/50 text-xs">Không tìm thấy bài viết nào.</div>';
        return;
      }

      blogItems.forEach(item => {
        const cleanName = item.path.replace('src/data/blog/', '').replace(/\.mdx?$/, '');
        const btn = document.createElement('button');
        btn.className = `w-full text-left py-1.5 px-2.5 rounded hover:bg-muted/50 transition-colors text-xs flex items-center gap-2 text-foreground/80 hover:text-foreground truncate font-medium`;
        
        // Highlight active file
        if (currentFile && currentFile.path === item.path) {
          btn.className += ' bg-accent/10 border-l-2 border-accent text-accent hover:bg-accent/15';
        }
        
        btn.innerHTML = `📝 <span class="truncate" title="${cleanName}">${cleanName}</span>`;
        btn.addEventListener('click', () => loadFile(item.path, item.sha, 'blog'));
        filesListContainer.appendChild(btn);
      });
    } else {
      // Docs mode
      const docsTree = buildDocsTree(repoFiles);
      
      if (Object.keys(docsTree.children).length === 0 && docsTree.files.length === 0) {
        filesListContainer.innerHTML = '<div class="text-center py-8 text-foreground/50 text-xs">Không tìm thấy tài liệu nào.</div>';
        return;
      }
      
      const treeRootContainer = document.createElement('div');
      treeRootContainer.className = 'space-y-1';
      renderFolderTree(docsTree, treeRootContainer, 0);
      filesListContainer.appendChild(treeRootContainer);
    }
  }

  // Recursive folder tree render in sidebar
  function renderFolderTree(node: any, container: HTMLElement, level = 0) {
    const childrenKeys = Object.keys(node.children);
    childrenKeys.sort();
    node.files.sort((a: any, b: any) => a.name.localeCompare(b.name));
    
    // Directories
    for (const key of childrenKeys) {
      const child = node.children[key];
      const folderEl = document.createElement('div');
      folderEl.className = 'py-0.5';
      
      const headerEl = document.createElement('button');
      headerEl.className = 'w-full text-left flex items-center gap-1.5 py-1 px-1.5 hover:bg-muted/40 rounded transition-colors text-xs font-semibold text-foreground/90';
      headerEl.style.paddingLeft = `${level * 10 + 6}px`;
      headerEl.innerHTML = `
        <svg class="w-3 h-3 text-accent transition-transform transform rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        <span>📂 ${child.name}</span>
      `;
      
      const childrenContainer = document.createElement('div');
      childrenContainer.className = 'hidden border-l border-border/40 ml-2.5 pl-1 my-0.5';
      
      headerEl.addEventListener('click', () => {
        const isHidden = childrenContainer.classList.contains('hidden');
        if (isHidden) {
          childrenContainer.classList.remove('hidden');
          headerEl.querySelector('svg')?.classList.add('rotate-90');
        } else {
          childrenContainer.classList.add('hidden');
          headerEl.querySelector('svg')?.classList.remove('rotate-90');
        }
      });
      
      folderEl.appendChild(headerEl);
      folderEl.appendChild(childrenContainer);
      container.appendChild(folderEl);
      
      renderFolderTree(child, childrenContainer, level + 1);
    }
    
    // Files
    for (const file of node.files) {
      if (file.name === '_meta.json') continue;
      
      const cleanName = file.name.replace(/\.mdx?$/, '');
      const fileEl = document.createElement('button');
      fileEl.className = 'w-full text-left py-1 px-2 rounded hover:bg-muted/50 transition-colors text-xs flex items-center gap-2 text-foreground/75 hover:text-foreground truncate';
      fileEl.style.paddingLeft = `${level * 10 + 18}px`;
      
      // Highlight active file
      if (currentFile && currentFile.path === file.path) {
        fileEl.className += ' bg-accent/10 border-l-2 border-accent text-accent hover:bg-accent/15';
      }
      
      fileEl.innerHTML = `📝 <span class="truncate" title="${cleanName}">${cleanName}</span>`;
      fileEl.addEventListener('click', () => loadFile(file.path, file.sha, 'docs'));
      container.appendChild(fileEl);
    }
  }

