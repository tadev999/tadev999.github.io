---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Content Management System (CMS)">
  <Header />

  <main id="main-content" class="w-full px-4 py-6 max-w-7xl mx-auto flex-grow flex flex-col">
    <!-- Main Toast Notification Container -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- 1. Authentication Screen (Hidden when logged in) -->
    <div id="auth-container" class="flex-grow flex items-center justify-center py-12">
      <div class="w-full max-w-md bg-muted/20 border border-border/80 rounded-2xl p-8 backdrop-blur-md shadow-xl transition-all">
        <div class="text-center mb-6">
          <div class="text-3xl mb-2">🔐</div>
          <h2 class="text-2xl font-bold tracking-tight">Quản trị Website</h2>
          <p class="text-sm text-foreground/70 mt-1">Đăng nhập bằng GitHub Personal Access Token để cập nhật nội dung từ mọi thiết bị.</p>
        </div>

        <form id="auth-form" class="space-y-4">
          <div>
            <label for="github-token" class="block text-xs font-semibold uppercase tracking-wider text-foreground/80 mb-1.5">
              GitHub Access Token (Classic)
            </label>
            <input
              type="password"
              id="github-token"
              placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
              required
              class="w-full px-4 py-2.5 bg-background border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent text-sm"
            />
          </div>

          <button
            type="submit"
            class="w-full py-2.5 px-4 bg-accent text-white font-medium rounded-lg hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent/50 transition-all text-sm flex items-center justify-center gap-2"
          >
            <span>Đăng nhập</span>
            <svg id="login-spinner" class="animate-spin h-4 w-4 hidden" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          </button>
        </form>

        <div class="mt-6 border-t border-border/60 pt-4 text-xs text-foreground/60 leading-relaxed space-y-1">
          <p class="font-medium text-foreground/80">Làm sao để lấy token?</p>
          <p>1. Vào <a href="https://github.com/settings/tokens" target="_blank" class="text-accent underline hover:text-accent/80">GitHub Settings > Developer Settings > Tokens (Classic)</a>.</p>
          <p>2. Chọn **Generate new token (classic)**.</p>
          <p>3. Đặt tên và tick chọn quyền **repo** (quyền đọc/ghi kho chứa).</p>
          <p>4. Copy token và dán vào ô phía trên.</p>
          <p class="text-[10px] text-accent/80 mt-2 font-medium">⚠️ Token được lưu an toàn trực tiếp trên trình duyệt của bạn (localStorage), không gửi đi bất kỳ máy chủ trung gian nào.</p>
        </div>
      </div>
    </div>

    <!-- 2. Main CMS Dashboard (Hidden when logged out) -->
    <div id="cms-dashboard" class="hidden flex-grow grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Left column: File listing / tree explorer -->
      <div class="lg:col-span-3 bg-muted/10 border border-border/60 rounded-xl p-4 flex flex-col min-h-[300px] lg:min-h-0 lg:max-h-[80vh] overflow-hidden">
        <div class="flex items-center justify-between pb-3 border-b border-border/50 mb-3">
          <div class="flex items-center gap-1.5">
            <span class="text-xl">✍️</span>
            <span class="font-bold text-sm tracking-wide">TRANG QUẢN TRỊ</span>
          </div>
          <button id="logout-btn" title="Đăng xuất" class="px-2 py-1 text-xs border border-border rounded hover:bg-muted text-foreground/75 hover:text-foreground transition-all">
            Đăng xuất
          </button>
        </div>

        <!-- Create buttons -->
        <div class="grid grid-cols-2 gap-2 mb-4">
          <button id="new-blog-btn" class="py-1.5 px-2 bg-accent text-white text-xs font-semibold rounded hover:bg-accent/90 transition-all flex items-center justify-center gap-1 shadow-sm">
            ➕ Blog Post
          </button>
          <button id="new-doc-btn" class="py-1.5 px-2 bg-accent text-white text-xs font-semibold rounded hover:bg-accent/90 transition-all flex items-center justify-center gap-1 shadow-sm">
            ➕ Doc Page
          </button>
        </div>

        <!-- Tabs Switcher -->
        <div class="flex border-b border-border/40 mb-3 text-xs font-medium">
          <button id="tab-blog" class="flex-1 pb-2 border-b-2 border-accent text-center text-accent focus:outline-none">
            Blog Posts
          </button>
          <button id="tab-docs" class="flex-1 pb-2 border-b-2 border-transparent text-center text-foreground/60 hover:text-foreground focus:outline-none">
            Docs (Menu)
          </button>
        </div>

        <!-- Files list container -->
        <div class="flex-grow overflow-y-auto pr-1 select-none space-y-1" id="files-list-container">
          <div class="text-center py-8 text-foreground/50 text-xs">
            Đang tải dữ liệu từ GitHub...
          </div>
        </div>
      </div>

      <!-- Right column: Main Workspace (Editor / Welcome screen) -->
      <div class="lg:col-span-9 flex flex-col bg-muted/5 border border-border/60 rounded-xl overflow-hidden min-h-[500px] lg:max-h-[80vh]">
        
        <!-- 2a. Welcome Screen (shown when no file is active) -->
        <div id="welcome-pane" class="flex-grow flex flex-col items-center justify-center text-center p-8">
          <div class="text-5xl mb-4 animate-bounce">🚀</div>
          <h3 class="text-xl font-bold">Chào mừng tới trang viết bài</h3>
          <p class="text-sm text-foreground/70 max-w-md mt-2 leading-relaxed">
            Chọn một bài viết hoặc tài liệu từ thanh bên trái để bắt đầu chỉnh sửa, hoặc bấm nút tạo mới ở phía trên.
          </p>
          <div class="mt-6 p-4 border border-border/50 bg-muted/20 rounded-lg text-left text-xs max-w-lg space-y-2 leading-relaxed text-foreground/85">
            <p class="font-semibold text-foreground">💡 Lưu ý quy trình hoạt động:</p>
            <p>• Khi bấm **Lưu bài viết**, một commit mới sẽ được tạo thẳng vào nhánh `main` của repository của bạn.</p>
            <p>• Hệ thống **GitHub Actions** sẽ lập tức tự động chạy build lại trang web (mất khoảng 1 - 2 phút).</p>
            <p>• Sau khi GitHub Actions hoàn thành, nội dung mới sẽ xuất hiện trực tiếp trên website của bạn.</p>
          </div>
        </div>

        <!-- 2b. Form and Editor Pane (shown when creating/editing) -->
        <div id="editor-pane" class="hidden flex-grow flex flex-col overflow-hidden">
          
          <!-- Editor Header Toolbar -->
          <div class="bg-muted/30 border-b border-border/60 px-4 py-2 flex items-center justify-between gap-4">
            <div class="flex items-center gap-2 min-w-0">
              <span id="editor-status-icon" class="text-base flex-shrink-0">📝</span>
              <span id="editor-filename" class="font-mono text-xs font-semibold truncate text-foreground/80"></span>
            </div>
            
            <div class="flex items-center gap-2">
              <button id="delete-btn" class="hidden py-1 px-3 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded transition-all">
                Xoá Bài
              </button>
              <button id="cancel-btn" class="py-1 px-3 border border-border rounded hover:bg-muted text-xs font-medium text-foreground/80 transition-all">
                Đóng
              </button>
              <button id="save-btn" class="py-1.5 px-4 bg-accent hover:bg-accent/90 text-white text-xs font-bold rounded transition-all flex items-center gap-1.5 shadow-sm">
                <span>Lưu Bài Viết</span>
                <svg id="save-spinner" class="animate-spin h-3.5 w-3.5 hidden" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
              </button>
            </div>
          </div>

          <!-- Metadata Fields Form -->
          <div class="p-4 border-b border-border/50 bg-muted/10 grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[30vh] overflow-y-auto">
            <!-- Common Fields -->
            <div class="space-y-3">
              <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-foreground/70 mb-1">Tiêu Đề (Title) *</label>
                <input type="text" id="post-title" placeholder="Nhập tiêu đề..." class="w-full px-3 py-1.5 text-sm bg-background border border-border rounded focus:outline-none focus:ring-1 focus:ring-accent" />
              </div>
              <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-foreground/70 mb-1">Mô Tả Ngắn (Description)</label>
                <textarea id="post-desc" rows="2" placeholder="Tóm tắt nội dung bài viết..." class="w-full px-3 py-1.5 text-xs bg-background border border-border rounded focus:outline-none focus:ring-1 focus:ring-accent resize-none"></textarea>
              </div>
              <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-foreground/70 mb-1">Commit Message (Thông điệp commit - không bắt buộc)</label>
                <input type="text" id="post-commit-msg" placeholder="[Tự động] Nhập nội dung commit..." class="w-full px-3 py-1.5 text-xs bg-background border border-border rounded focus:outline-none focus:ring-1 focus:ring-accent" />
              </div>
            </div>

            <!-- Dynamic Section (Blog vs Docs) -->
            <div class="space-y-3">
              <!-- Blog Only Fields -->
              <div id="blog-fields" class="space-y-3">
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-foreground/70 mb-1">Tác giả (Author)</label>
                    <input type="text" id="post-author" placeholder="tadev999" class="w-full px-3 py-1.5 text-xs bg-background border border-border rounded focus:outline-none focus:ring-1 focus:ring-accent" />
                  </div>
                  <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-foreground/70 mb-1">Ngày đăng (Date)</label>
                    <input type="datetime-local" id="post-date" class="w-full px-3 py-1.5 text-xs bg-background border border-border rounded focus:outline-none focus:ring-1 focus:ring-accent" />
                  </div>
                </div>
                <div>
                  <label class="block text-[10px] font-bold uppercase tracking-wider text-foreground/70 mb-1">Tags (Nhập tag rồi ấn Enter)</label>
                  <div class="border border-border bg-background rounded p-1.5 flex flex-wrap gap-1 items-center">
                    <div id="tags-list" class="flex flex-wrap gap-1"></div>
                    <input type="text" id="post-tag-input" placeholder="Thêm tag..." class="outline-none bg-transparent text-xs py-0.5 px-1 flex-grow min-w-[60px]" />
                  </div>
                  <!-- Suggested Tags List -->
                  <div id="tag-suggestions" class="flex flex-wrap gap-1 mt-1 text-[10px] text-foreground/60">
                    <span>Gợi ý:</span>
                  </div>
                </div>
                <div class="flex items-center gap-2 pt-1">
                  <input type="checkbox" id="post-featured" class="w-4 h-4 text-accent border-border rounded focus:ring-accent focus:ring-0" />
                  <label for="post-featured" class="text-xs font-semibold text-foreground/80 select-none">Đánh dấu là bài viết Nổi bật (Featured)</label>
                </div>
              </div>

              <!-- Docs Only Fields -->
              <div id="docs-fields" class="hidden space-y-3">
                <div class="grid grid-cols-3 gap-2">
                  <div class="col-span-2">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-foreground/70 mb-1">Thư mục/Chuyên mục (Category) *</label>
                    <select id="doc-category" class="w-full px-3 py-1.5 text-xs bg-background border border-border rounded focus:outline-none focus:ring-1 focus:ring-accent">
                      <!-- Dynamically filled -->
                    </select>
                  </div>
                  <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-foreground/70 mb-1">Thứ tự (Order) *</label>
                    <input type="number" id="doc-order" value="0" class="w-full px-3 py-1.5 text-xs bg-background border border-border rounded focus:outline-none focus:ring-1 focus:ring-accent" />
                  </div>
                </div>

                <!-- Custom folder inputs (shown when [Create new folder] is selected) -->
                <div id="new-folder-inputs" class="hidden grid grid-cols-2 gap-2 p-2.5 bg-muted/30 border border-border/50 rounded">
                  <div>
                    <label class="block text-[9px] font-bold text-foreground/75 mb-0.5">Slug thư mục (vd: mach-6-ren-luyen)</label>
                    <input type="text" id="new-folder-slug" placeholder="slug-folder" class="w-full px-2 py-1 text-xs bg-background border border-border rounded focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-[9px] font-bold text-foreground/75 mb-0.5">Tiêu đề thư mục (vd: Mạch 6: Rèn Luyện)</label>
                    <input type="text" id="new-folder-title" placeholder="Tiêu Đề Thư Mục" class="w-full px-2 py-1 text-xs bg-background border border-border rounded focus:outline-none" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Split Workspace (Textarea / Markdown Preview) -->
          <div class="flex-grow flex flex-col md:flex-row overflow-hidden min-h-0">
            <!-- Left panel: Text Editor -->
            <div class="flex-1 flex flex-col border-b md:border-b-0 md:border-r border-border/50 h-1/2 md:h-full overflow-hidden">
              <div class="bg-muted/10 px-3 py-1 border-b border-border/40 text-[10px] font-bold text-foreground/60 flex items-center justify-between">
                <span>NỘI DUNG MARKDOWN</span>
                <span id="word-count" class="font-mono">0 từ</span>
              </div>
              <textarea
                id="editor-textarea"
                spellcheck="false"
                placeholder="Viết nội dung bài viết bằng định dạng Markdown ở đây..."
                class="w-full flex-grow p-4 bg-background text-sm font-mono focus:outline-none resize-none overflow-y-auto leading-relaxed"
              ></textarea>
            </div>

            <!-- Right panel: Live HTML Preview -->
            <div class="flex-1 flex flex-col h-1/2 md:h-full overflow-hidden bg-background">
              <div class="bg-muted/10 px-3 py-1 border-b border-border/40 text-[10px] font-bold text-foreground/60">
                XEM TRƯỚC (LIVE PREVIEW)
              </div>
              <div
                id="preview-pane"
                class="flex-grow p-4 overflow-y-auto preview-content selection:bg-accent/40 selection:text-foreground"
              >
                <!-- Dynamically rendered markdown content -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="delete-modal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden px-4">
      <div class="bg-background border border-border rounded-xl max-w-sm w-full p-6 shadow-2xl space-y-4">
        <h4 class="text-lg font-bold text-red-600 flex items-center gap-1.5">⚠️ Xác nhận xoá</h4>
        <p class="text-sm text-foreground/80 leading-relaxed">
          Bạn có chắc chắn muốn xoá bài viết <span id="delete-modal-filename" class="font-mono text-xs font-bold text-red-600 bg-red-100 dark:bg-red-950/40 px-1 py-0.5 rounded"></span>?
          Thao tác này sẽ xoá hoàn toàn file trên GitHub và không thể hoàn tác.
        </p>
        <div class="flex justify-end gap-2 text-xs font-semibold">
          <button id="delete-modal-cancel" class="px-4 py-2 border border-border rounded hover:bg-muted text-foreground/80 transition-all">Huỷ</button>
          <button id="delete-modal-confirm" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded transition-all">Xoá ngay</button>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<!-- Load Marked for Markdown compilation in real-time -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>

<style is:inline>
  /* Custom styles for preview content matching typical blog page styles */
  .preview-content h1 {
    font-size: 1.85rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
    color: var(--foreground);
  }
  .preview-content h2 {
    font-size: 1.4rem;
    font-weight: 600;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--foreground);
  }
  .preview-content h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.4rem;
    color: var(--foreground);
  }
  .preview-content p {
    margin-bottom: 0.85rem;
    line-height: 1.6;
    color: var(--foreground);
    opacity: 0.95;
  }
  .preview-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 0.85rem;
  }
  .preview-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 0.85rem;
  }
  .preview-content li {
    margin-bottom: 0.2rem;
    line-height: 1.5;
  }
  .preview-content code {
    font-family: monospace !important;
    background-color: var(--muted);
    color: var(--accent) !important;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
  }
  .preview-content pre {
    background-color: var(--muted);
    border: 1px solid var(--border);
    padding: 0.85rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 0.85rem;
  }
  .preview-content pre code {
    background-color: transparent !important;
    color: var(--foreground) !important;
    padding: 0;
    font-size: 0.85rem;
  }
  .preview-content blockquote {
    border-left: 4px solid var(--accent);
    padding-left: 0.85rem;
    color: var(--foreground);
    opacity: 0.8;
    font-style: italic;
    margin-bottom: 0.85rem;
    background-color: var(--muted)/20;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }
  .preview-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 0.85rem;
    font-size: 0.9rem;
  }
  .preview-content th, .preview-content td {
    border: 1px solid var(--border);
    padding: 0.4rem 0.6rem;
    text-align: left;
  }
  .preview-content th {
    background-color: var(--muted);
    font-weight: 600;
  }
</style>

<script>
  // GitHub Repository settings
  const REPO_OWNER = 'tadev999';
  const REPO_NAME = 'tadev999.github.io';
  const BRANCH = 'main';

  // State
  let gitToken = '';
  let repoFiles: any[] = [];
  let existingTags: string[] = [];
  let activeTab: 'blog' | 'docs' = 'blog';
  
  // Active document state
  let currentFile: {
    path: string;
    sha: string | null;
    type: 'blog' | 'docs';
    isNew: boolean;
    originalContent: string;
  } | null = null;

  let activeTags: string[] = [];

  let activeMetaFile: {
    path: string;
    sha: string | null;
    config: any;
  } | null = null;

  // DOM Elements
  const authContainer = document.getElementById('auth-container')!;
  const cmsDashboard = document.getElementById('cms-dashboard')!;
  const authForm = document.getElementById('auth-form')!;
  const tokenInput = document.getElementById('github-token') as HTMLInputElement;
  const loginSpinner = document.getElementById('login-spinner')!;
  const logoutBtn = document.getElementById('logout-btn')!;
  
  const filesListContainer = document.getElementById('files-list-container')!;
  const tabBlog = document.getElementById('tab-blog')!;
  const tabDocs = document.getElementById('tab-docs')!;
  const newBlogBtn = document.getElementById('new-blog-btn')!;
  const newDocBtn = document.getElementById('new-doc-btn')!;
  
  const welcomePane = document.getElementById('welcome-pane')!;
  const editorPane = document.getElementById('editor-pane')!;
  const editorFilename = document.getElementById('editor-filename')!;
  const editorStatusIcon = document.getElementById('editor-status-icon')!;
  const editorTextarea = document.getElementById('editor-textarea') as HTMLTextAreaElement;
  const previewPane = document.getElementById('preview-pane')!;
  const wordCount = document.getElementById('word-count')!;
  
  const postTitle = document.getElementById('post-title') as HTMLInputElement;
  const postDesc = document.getElementById('post-desc') as HTMLTextAreaElement;
  const postCommitMsg = document.getElementById('post-commit-msg') as HTMLInputElement;
  
  const blogFields = document.getElementById('blog-fields')!;
  const postAuthor = document.getElementById('post-author') as HTMLInputElement;
  const postDate = document.getElementById('post-date') as HTMLInputElement;
  const tagsList = document.getElementById('tags-list')!;
  const postTagInput = document.getElementById('post-tag-input') as HTMLInputElement;
  const tagSuggestions = document.getElementById('tag-suggestions')!;
  const postFeatured = document.getElementById('post-featured') as HTMLInputElement;
  
  const docsFields = document.getElementById('docs-fields')!;
  const docCategory = document.getElementById('doc-category') as HTMLSelectElement;
  const docOrder = document.getElementById('doc-order') as HTMLInputElement;
  const newFolderInputs = document.getElementById('new-folder-inputs')!;
  const newFolderSlug = document.getElementById('new-folder-slug') as HTMLInputElement;
  const newFolderTitle = document.getElementById('new-folder-title') as HTMLInputElement;

  const saveBtn = document.getElementById('save-btn')!;
  const saveSpinner = document.getElementById('save-spinner')!;
  const cancelBtn = document.getElementById('cancel-btn')!;
  const deleteBtn = document.getElementById('delete-btn')!;

  const deleteModal = document.getElementById('delete-modal')!;
  const deleteModalFilename = document.getElementById('delete-modal-filename')!;
  const deleteModalCancel = document.getElementById('delete-modal-cancel')!;
  const deleteModalConfirm = document.getElementById('delete-modal-confirm')!;

  // Toast System
  function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
    const container = document.getElementById('toast-container')!;
    const toast = document.createElement('div');
    toast.className = `px-4 py-3 rounded-lg shadow-lg text-white text-xs font-semibold flex items-center justify-between gap-3 pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300 max-w-sm`;
    
    let bg = 'bg-accent';
    if (type === 'success') bg = 'bg-emerald-600';
    if (type === 'error') bg = 'bg-rose-600';
    
    toast.className += ` ${bg}`;
    toast.innerHTML = `
      <span>${message}</span>
      <button class="text-white/80 hover:text-white font-bold text-sm ml-2" onclick="this.parentElement.remove()">✕</button>
    `;
    
    container.appendChild(toast);
    
    // trigger animation
    setTimeout(() => {
