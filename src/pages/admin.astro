  // Tag manager helper renders
  function renderTags() {
    tagsList.innerHTML = '';
    activeTags.forEach((tag, idx) => {
      const badge = document.createElement('span');
      badge.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-accent/10 border border-accent/30 text-accent text-xs rounded-full font-semibold';
      badge.innerHTML = `
        <span>${tag}</span>
        <button type="button" class="hover:text-rose-500 font-bold focus:outline-none" data-idx="${idx}">✕</button>
      `;
      badge.querySelector('button')?.addEventListener('click', (e) => {
        const i = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-idx')!);
        activeTags.splice(i, 1);
        renderTags();
      });
      tagsList.appendChild(badge);
    });

    // Render suggestions that aren't already selected
    tagSuggestions.innerHTML = '<span>Gợi ý:</span>';
    const unusedSuggestions = existingTags.filter(t => !activeTags.includes(t));
    
    if (unusedSuggestions.length === 0) {
      tagSuggestions.classList.add('hidden');
    } else {
      tagSuggestions.classList.remove('hidden');
      unusedSuggestions.forEach(tag => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'px-1.5 py-0.5 bg-muted rounded hover:bg-muted/70 transition-all font-medium text-foreground/80';
        btn.textContent = `+ ${tag}`;
        btn.addEventListener('click', () => {
          activeTags.push(tag);
          renderTags();
        });
        tagSuggestions.appendChild(btn);
      });
    }
  }

  // Handle enter key in tags input
  postTagInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      const val = postTagInput.value.trim().replace(/,/g, '');
      if (val && !activeTags.includes(val)) {
        activeTags.push(val);
        renderTags();
      }
      postTagInput.value = '';
    }
  });

  // Save to GitHub
  saveBtn.addEventListener('click', async () => {
    if (!currentFile) return;

    const title = postTitle.value.trim();
    const markdownContent = editorTextarea.value;

    if (!title) {
      showToast('Vui lòng nhập Tiêu đề!', 'error');
      return;
    }

    saveSpinner.classList.remove('hidden');
    saveBtn.setAttribute('disabled', 'true');

    try {
      let finalFilePath = '';
      let frontmatterData: Record<string, any> = {};

      if (currentFile.type === 'blog') {
        const desc = postDesc.value.trim();
        const author = postAuthor.value.trim() || 'tadev999';
        const dateVal = postDate.value ? new Date(postDate.value).toISOString() : new Date().toISOString();
        const featured = postFeatured.checked;

        frontmatterData = {
          title,
          pubDatetime: dateVal,
          author,
          tags: activeTags,
          featured,
          draft: false,
          description: desc
        };

        if (currentFile.isNew) {
          // Slugify title for new file
          const slug = title.toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '') // Remove symbols
            .replace(/\s+/g, '-')          // Replace spaces with hyphens
            .replace(/-+/g, '-')           // Remove double hyphens
            .trim();
          finalFilePath = `src/data/blog/${slug}.md`;
        } else {
          finalFilePath = currentFile.path;
        }
      } else {
        // docs
        const desc = postDesc.value.trim();
        const order = parseInt(docOrder.value) || 0;
        let category = docCategory.value;

        frontmatterData = {
          title,
          description: desc,
          order
        };

        let isNewFolder = false;
        let folderTitle = '';

        if (category === '__new__') {
          // User is creating a new directory!
          const folderSlug = newFolderSlug.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '');
          folderTitle = newFolderTitle.value.trim();
          
          if (!folderSlug || !folderTitle) {
            throw new Error('Vui lòng nhập đầy đủ Slug và Tiêu đề cho thư mục mới!');
          }

          category = folderSlug;
          isNewFolder = true;
        }

        // Determine the filename
        let filename = '';
        if (currentFile.isNew) {
          let needsIndex = isNewFolder;
          if (!needsIndex && category) {
            const hasIndexMd = repoFiles.some(item => 
              item.path === `src/data/docs/${category}/index.md` || 
              item.path === `src/data/docs/${category}/index.mdx`
            );
            if (!hasIndexMd) {
              needsIndex = true;
            }
          }

          if (needsIndex) {
            filename = 'index.md';
          } else {
            const slug = title.toLowerCase()
              .replace(/[^a-z0-9\s-]/g, '')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .trim();
            filename = `${slug}.md`;
          }
          finalFilePath = category ? `src/data/docs/${category}/${filename}` : `src/data/docs/${filename}`;
        } else {
          finalFilePath = currentFile.path;
          filename = finalFilePath.split('/').pop()!;
        }

        // Save _meta.json for new folder or update existing folder meta
        if (isNewFolder) {
          const metaPath = `src/data/docs/${category}/_meta.json`;
          const metaConfig = {
            title: folderTitle,
            order: {
              [filename]: order
            }
          };
          const metaContent = JSON.stringify(metaConfig, null, 2);
          
          showToast(`Đang tạo thư mục mới: "${folderTitle}"...`, 'info');
          await commitFileToGitHub(metaPath, metaContent, `create category config for ${category}`, null);
        } else if (category) {
          const metaPath = `src/data/docs/${category}/_meta.json`;
          const metaFileEntry = repoFiles.find(item => item.path === metaPath);
          
          let metaSha = null;
          let metaConfig: any = {};
          
          if (metaFileEntry) {
            metaSha = metaFileEntry.sha;
            if (activeMetaFile && activeMetaFile.path === metaPath) {
              metaConfig = activeMetaFile.config;
              metaSha = activeMetaFile.sha;
            } else {
              try {
                const metaRes = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${metaPath}?ref=${BRANCH}`, {
                  headers: {
                    'Authorization': `token ${gitToken}`,
                    'Accept': 'application/vnd.github.v3+json'
                  }
                });
                if (metaRes.ok) {
                  const metaData = await metaRes.json();
                  const metaUtf8 = decodeURIComponent(atob(metaData.content.replace(/\s/g, '')).split('').map(function(c) {
                      return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                  }).join(''));
                  metaConfig = JSON.parse(metaUtf8);
                  metaSha = metaData.sha;
                }
              } catch (e) {
                console.error('Failed to fetch meta config on save', e);
              }
            }
          }

          metaConfig.title = metaConfig.title || category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
          metaConfig.order = metaConfig.order || {};
          metaConfig.order[filename] = order;

          const metaContent = JSON.stringify(metaConfig, null, 2);
          showToast(`Đang cập nhật cấu hình thứ tự trong thư mục...`, 'info');
          await commitFileToGitHub(metaPath, metaContent, `Update ordering in ${category} meta config`, metaSha);
        }
      }

      // Compile content string
      const fileContent = stringifyFrontmatter(frontmatterData) + '\n' + markdownContent;
      
      // Commit
      const actionMsg = currentFile.isNew ? 'Create' : 'Update';
      const defaultCommitMsg = `${actionMsg} post: ${title}`;
      const userCommitMsg = postCommitMsg.value.trim();
      const finalCommitMsg = userCommitMsg || defaultCommitMsg;

      showToast(`Đang commit lên GitHub...`, 'info');
      
      await commitFileToGitHub(
        finalFilePath, 
        fileContent, 
        finalCommitMsg, 
        currentFile.sha
      );

      showToast(`Đã lưu thành công! Đang build lại website (mất 1-2 phút).`, 'success');

      // Update local states and reload file list
      currentFile = null;
      welcomePane.classList.remove('hidden');
      editorPane.classList.add('hidden');
      
      await fetchRepoFiles();
    } catch (err: any) {
      showToast(err.message, 'error');
    } finally {
      saveSpinner.classList.add('hidden');
      saveBtn.removeAttribute('disabled');
    }
  });

  // Base64 helper supporting UTF-8 for GitHub Contents API
  function commitFileToGitHub(path: string, content: string, message: string, sha: string | null) {
    const utf8Bytes = new TextEncoder().encode(content);
    // Convert bytes to base64 binary string
    let binary = '';
    const len = utf8Bytes.byteLength;
    for (let i = 0; i < len; i++) {
        binary += String.fromCharCode(utf8Bytes[i]);
    }
    const base64Content = btoa(binary);

    const body: Record<string, any> = {
      message: message,
      content: base64Content,
      branch: BRANCH
    };

    if (sha) {
      body.sha = sha;
    }

    return fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${path}`, {
      method: 'PUT',
      headers: {
        'Authorization': `token ${gitToken}`,
        'Content-Type': 'application/json',
        'Accept': 'application/vnd.github.v3+json'
      },
      body: JSON.stringify(body)
    }).then(async res => {
      if (!res.ok) {
        const errData = await res.json();
        throw new Error(errData.message || 'Lỗi khi đồng bộ file lên GitHub.');
      }
      return res.json();
    });
  }

  // Delete File triggers
  deleteBtn.addEventListener('click', () => {
    if (!currentFile || currentFile.isNew) return;
    
    const filename = currentFile.path.split('/').pop()!;
    deleteModalFilename.textContent = filename;
    deleteModal.classList.remove('hidden');
  });

  deleteModalCancel.addEventListener('click', () => {
    deleteModal.classList.add('hidden');
  });

  deleteModalConfirm.addEventListener('click', async () => {
    if (!currentFile || currentFile.isNew) return;

    deleteModal.classList.add('hidden');
    saveSpinner.classList.remove('hidden');
    saveBtn.setAttribute('disabled', 'true');

    const filePath = currentFile.path;
    const sha = currentFile.sha!;

    try {
      // If docs mode, remove from _meta.json ordering
      if (currentFile.type === 'docs') {
        const parts = filePath.split('/');
        const categoryParts = parts.slice(3, -1);
        const category = categoryParts.join('/');
        const filename = parts[parts.length - 1];
        
        if (category) {
          const metaPath = `src/data/docs/${category}/_meta.json`;
          const metaFileEntry = repoFiles.find(item => item.path === metaPath);
          if (metaFileEntry) {
            let metaSha = metaFileEntry.sha;
            let metaConfig: any = {};
            
            if (activeMetaFile && activeMetaFile.path === metaPath) {
              metaConfig = activeMetaFile.config;
              metaSha = activeMetaFile.sha;
            } else {
              try {
                const metaRes = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${metaPath}?ref=${BRANCH}`, {
                  headers: {
                    'Authorization': `token ${gitToken}`,
                    'Accept': 'application/vnd.github.v3+json'
                  }
                });
                if (metaRes.ok) {
                  const metaData = await metaRes.json();
                  const metaUtf8 = decodeURIComponent(atob(metaData.content.replace(/\s/g, '')).split('').map(function(c) {
                      return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                  }).join(''));
                  metaConfig = JSON.parse(metaUtf8);
                  metaSha = metaData.sha;
                }
              } catch (e) {
                console.error('Failed to fetch meta config on delete', e);
              }
            }
            
            if (metaConfig.order && metaConfig.order[filename] !== undefined) {
              delete metaConfig.order[filename];
              const metaContent = JSON.stringify(metaConfig, null, 2);
              showToast(`Đang xoá bài khỏi danh sách sắp xếp thư mục...`, 'info');
              await commitFileToGitHub(metaPath, metaContent, `Remove ${filename} from ${category} meta config`, metaSha);
            }
          }
        }
      }

      showToast('Đang xoá file trên GitHub...', 'info');
      const res = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${filePath}`, {
        method: 'DELETE',
        headers: {
          'Authorization': `token ${gitToken}`,
          'Content-Type': 'application/json',
          'Accept': 'application/vnd.github.v3+json'
        },
        body: JSON.stringify({
          message: `Delete post: ${filePath.split('/').pop()}`,
          sha: sha,
          branch: BRANCH
        })
      });

      if (!res.ok) {
        const errData = await res.json();
        throw new Error(errData.message || 'Lỗi khi xoá file trên GitHub.');
      }

      showToast('Xoá bài viết thành công!', 'success');
      currentFile = null;
      welcomePane.classList.remove('hidden');
      editorPane.classList.add('hidden');
      
      await fetchRepoFiles();
    } catch (err: any) {
      showToast(err.message, 'error');
    } finally {
      saveSpinner.classList.add('hidden');
      saveBtn.removeAttribute('disabled');
    }
  });

  // Start checking authorization on load
  document.addEventListener('DOMContentLoaded', initAuth);
  document.addEventListener('astro:after-swap', initAuth);
</script>
