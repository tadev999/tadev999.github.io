  // File loading
  async function loadFile(filePath: string, sha: string, type: 'blog' | 'docs') {
    showToast(`Đang tải file: ${filePath.split('/').pop()}...`, 'info');
    activeMetaFile = null;
    
    try {
      const res = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${filePath}?ref=${BRANCH}`, {
        headers: {
          'Authorization': `token ${gitToken}`,
          'Accept': 'application/vnd.github.v3+json'
        }
      });

      if (!res.ok) {
        throw new Error('Không thể đọc nội dung file từ GitHub.');
      }

      const fileData = await res.json();
      // Base64 decode content utf-8 correctly
      const utf8Content = decodeURIComponent(atob(fileData.content.replace(/\s/g, '')).split('').map(function(c) {
          return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join(''));

      currentFile = {
        path: filePath,
        sha: sha,
        type: type,
        isNew: false,
        originalContent: utf8Content
      };

      // Set editor filename
      editorFilename.textContent = filePath;
      editorStatusIcon.textContent = type === 'blog' ? '📰' : '📚';

      // Parse markdown content
      const parsed = parseFrontmatter(utf8Content);
      
      // Load into fields
      postTitle.value = parsed.data.title || '';
      postDesc.value = parsed.data.description || '';
      postCommitMsg.value = '';
      editorTextarea.value = parsed.content || '';
      
      if (type === 'blog') {
        blogFields.classList.remove('hidden');
        docsFields.classList.add('hidden');
        
        postAuthor.value = parsed.data.author || '';

        // Handle date
        if (parsed.data.pubDatetime) {
          const date = new Date(parsed.data.pubDatetime);
          // Sử dụng trực tiếp toISOString() để giữ nguyên định dạng chuẩn UTC (có chữ Z ở cuối)
          postDate.value = date.toISOString(); 
        } else {
          postDate.value = '';
        }
        
        // Handle tags
        activeTags = parsed.data.tags || [];
        renderTags();
        
        postFeatured.checked = !!parsed.data.featured;
      } else {
        docsFields.classList.remove('hidden');
        blogFields.classList.add('hidden');
        
        // Determine category from path
        const parts = filePath.split('/');
        const categoryParts = parts.slice(3, -1);
        const category = categoryParts.join('/');
        docCategory.value = category;
        docCategory.dispatchEvent(new Event('change'));
        
        docOrder.value = String(parsed.data.order ?? 0);

        // Fetch _meta.json configuration if it exists to override order field
        if (category) {
          const metaPath = `src/data/docs/${category}/_meta.json`;
          const metaFileEntry = repoFiles.find(item => item.path === metaPath);
          if (metaFileEntry) {
            try {
              const metaRes = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${metaPath}?ref=${BRANCH}`, {
                headers: {
                  'Authorization': `token ${gitToken}`,
                  'Accept': 'application/vnd.github.v3+json'
                }
              });
              if (metaRes.ok) {
                const metaData = await metaRes.json();
                const metaUtf8 = decodeURIComponent(atob(metaData.content.replace(/\s/g, '')).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                const config = JSON.parse(metaUtf8);
                activeMetaFile = {
                  path: metaPath,
                  sha: metaData.sha,
                  config: config
                };
                
                const filename = parts[parts.length - 1];
                if (config.order && typeof config.order[filename] === 'number') {
                  docOrder.value = String(config.order[filename]);
                }
              }
            } catch (e) {
              console.error('Error loading _meta.json', e);
            }
          }
        }
      }

      // Hide welcome pane, show editor
      welcomePane.classList.add('hidden');
      editorPane.classList.remove('hidden');
      deleteBtn.classList.remove('hidden');
      
      // Update sidebar highlights
      renderFiles();
      updateWordCount();
      updatePreview();
    } catch (err: any) {
      showToast(err.message, 'error');
    }
  }

