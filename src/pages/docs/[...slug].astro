---
/**
 * Dynamic route for all documentation pages.
 *
 * Generates a page for each entry in the "docs" content collection.
 * Renders the doc content inside DocsLayout with the sidebar navigation.
 * The sidebar shows only pages within the same tutorial (top-level folder).
 *
 * Requirements: 10.1, 10.2, 10.3
 */
import { getCollection, render } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import { DirectoryScanner } from "@/utils/content/directoryScanner";
import { MetadataParser } from "@/utils/content/metadataParser";
import { NavigationGenerator } from "@/utils/content/navigationGenerator";
import type { FileNode, NavigationTree } from "@/types/navigation";
import { DOCS_PATH } from "@/content.config";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import * as path from "node:path";
import * as fs from "node:fs/promises";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map(entry => ({
    params: { slug: entry.id },
    props: { entry, allDocs: docs },
  }));
}

const { entry, allDocs } = Astro.props;
const { Content } = await render(entry);

// Determine which tutorial folder this page belongs to.
// entry.id examples: "vibe-coding" | "vibe-coding/setup" | "getting-started"
// tutorialSlug = first path segment, e.g. "vibe-coding"
const idParts = entry.id.split("/");
const tutorialSlug = idParts[0];

// Build navigation tree scoped to the current tutorial folder only.
async function getNavigationTree(): Promise<NavigationTree> {
  const docsAbsPath = path.resolve(process.cwd(), DOCS_PATH);
  // Scan only the tutorial's subdirectory (e.g. src/data/docs/vibe-coding/)
  const tutorialAbsPath = path.join(docsAbsPath, tutorialSlug);

  // Always scan the tutorial's own subdirectory.
  // For top-level pages like "vibe-coding" (index), tutorialAbsPath = .../docs/vibe-coding/
  // For sub-pages like "vibe-coding/setup", same tutorialAbsPath.
  const scanPath = tutorialAbsPath;

  try {
    await fs.stat(scanPath);
  } catch {
    return { root: [], byPath: new Map() };
  }

  const scanner = new DirectoryScanner({ rootPath: scanPath, maxDepth: 5 });
  const parser = new MetadataParser();
  // Use the tutorial folder as rootPath so URL paths are relative to it
  const generator = new NavigationGenerator({ rootPath: scanPath });

  let fileNodes: FileNode[] = [];
  try {
    fileNodes = await scanner.scan();
  } catch {
    return { root: [], byPath: new Map() };
  }

  // Enrich nodes with frontmatter + _meta.json metadata
  async function enrich(nodes: FileNode[], dirPath: string): Promise<FileNode[]> {
    const metaConfig = await parser.parseMetaFile(path.join(dirPath, "_meta.json"));
    const enriched: FileNode[] = [];
    for (const node of nodes) {
      if (node.type === "file") {
        let frontmatter = {};
        try {
          const raw = await fs.readFile(node.path, "utf-8");
          frontmatter = parser.parseFrontmatter(raw);
        } catch { /* ignore */ }
        enriched.push({ ...node, metadata: parser.mergeMetadata(frontmatter, metaConfig, node.name) });
      } else {
        const children = await enrich(node.children ?? [], node.path);
        const dirMeta = parser.mergeMetadata({}, metaConfig, node.name);
        try {
          const ownMeta = await parser.parseMetaFile(path.join(node.path, "_meta.json"));
          if (ownMeta.title) {
            dirMeta.title = ownMeta.title;
          }
        } catch { /* ignore */ }
        enriched.push({ ...node, children, metadata: dirMeta });
      }
    }
    return enriched;
  }

  fileNodes = await enrich(fileNodes, scanPath);

  // Generate tree — paths will be like "/index", "/setup", "/mindset"
  const rawTree = generator.generateTree(fileNodes);

  // Rewrite paths to full URL: "/index" → "/docs/vibe-coding", "/setup" → "/docs/vibe-coding/setup"
  function rewritePaths(items: typeof rawTree.root): typeof rawTree.root {
    return items.map(item => {
      // item.path is relative to scanPath, e.g. "/index" or "/setup"
      const relativePart = item.path.replace(/^\//, ""); // strip leading slash
      // "index" → tutorial root URL, anything else → subfolder URL
      const fullPath = relativePart === "index" || relativePart === ""
        ? `/docs/${tutorialSlug}`
        : `/docs/${tutorialSlug}/${relativePart}`;

      return {
        ...item,
        path: fullPath,
        id: fullPath,
        children: item.children ? rewritePaths(item.children) : undefined,
      };
    });
  }

  const rewrittenRoot = rewritePaths(rawTree.root);

  // Rebuild byPath map with rewritten paths
  const byPath = new Map<string, (typeof rewrittenRoot)[0]>();
  function indexItems(items: typeof rewrittenRoot) {
    for (const item of items) {
      byPath.set(item.path, item);
      if (item.children) indexItems(item.children);
    }
  }
  indexItems(rewrittenRoot);

  return { root: rewrittenRoot, byPath };
}

const navigationTree = await getNavigationTree();

// Current URL path
const currentPath = `/docs/${entry.id}`;

const pageTitle = entry.data.title;
const pageDescription = entry.data.description;

// ── Prev / Next within the same tutorial ──────────────────────────────────────
// Flatten the navigation tree to determine sequential reading order of files.
const flatPages: { title: string; href: string }[] = [];
function flatten(items: typeof navigationTree.root) {
  for (const item of items) {
    if (item.type === "file") {
      flatPages.push({ title: item.title, href: item.path });
    }
    if (item.children) {
      flatten(item.children);
    }
  }
}
flatten(navigationTree.root);

const currentIndex = flatPages.findIndex(p => p.href === currentPath);
const prevPage = currentIndex > 0 ? flatPages[currentIndex - 1] : null;
const nextPage = currentIndex !== -1 && currentIndex < flatPages.length - 1 ? flatPages[currentIndex + 1] : null;
---

<DocsLayout
  title={pageTitle}
  description={pageDescription}
  navigationTree={navigationTree}
  currentPath={currentPath}
>
  <div class="mb-6">
    <ShareLinks title={pageTitle} showText={false} />
  </div>

  <Content />

  <div class="mt-12">
    <ShareLinks title={pageTitle} />
  </div>

  <!-- Prev / Next navigation -->
  <hr class="my-8 border-dashed" />
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 not-prose">
    {prevPage && (
      <a
        href={prevPage.href}
        class="flex w-full gap-1 hover:opacity-75 text-foreground hover:text-accent transition-colors"
      >
        <IconChevronLeft class="inline-block flex-none mt-0.5" />
        <div>
          <div class="text-xs text-foreground/50 mb-0.5">Previous</div>
          <div class="text-sm font-medium">{prevPage.title}</div>
        </div>
      </a>
    )}
    {nextPage && (
      <a
        href={nextPage.href}
        class="flex w-full justify-end gap-1 text-end hover:opacity-75 text-foreground hover:text-accent transition-colors sm:col-start-2"
      >
        <div>
          <div class="text-xs text-foreground/50 mb-0.5">Next</div>
          <div class="text-sm font-medium">{nextPage.title}</div>
        </div>
        <IconChevronRight class="inline-block flex-none mt-0.5" />
      </a>
    )}
  </div>
</DocsLayout>
